# Optional server-side credentials for Node Logic Live HTTP.
# Keep these values empty in local templates; never use VITE_ prefixes.
# Configure only in the server environment when a specific external API is used.
FOLIO_SECRET_API_TOKEN=

# Comma-separated hostname allowlist required to enable the Cloudflare proxy.
# Use exact hostnames or a leading dot for a domain and its subdomains.
# Wildcard "*" is intentionally not supported.
FOLIO_PROXY_ALLOWED_HOSTS=

# Optional per-secret allowlist. When set, it takes precedence over the global
# FOLIO_PROXY_ALLOWED_HOSTS for this secret.
FOLIO_SECRET_API_TOKEN_ALLOWED_HOSTS=

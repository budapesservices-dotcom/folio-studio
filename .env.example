# =============================================================================
# Folio Studio — Server-Side Live HTTP Proxy Environment Variables
# =============================================================================
# Configure separately for Cloudflare Pages **Preview** and **Production**
# environments (Pages -> Settings -> Environment Variables).
# Never commit real tokens or secrets to git or `.flop` files.

# REQUIRED for Live HTTP Proxy (/api/logic/http-proxy):
# Comma-separated explicit hostnames or leading-dot subdomains.
# Wildcards ("*" or "*.example.com") are strictly forbidden and rejected.
# Example: api.github.com,.jsonplaceholder.typicode.com
FOLIO_PROXY_ALLOWED_HOSTS=

# REQUIRED backend authentication (configure Cloudflare Access OR Proxy Token):
# Option A (Recommended for Cloudflare Pages — Rp0 free tier up to 50 users):
# Protect your Pages deployment with Cloudflare Access and set both values:
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Option B (Alternative for local dev or non-Access environments):
# Shared secret validated against the `X-Folio-Proxy-Auth` request header.
FOLIO_PROXY_AUTH_TOKEN=

# OPTIONAL (default: false):
# Set to "true" ONLY if you intentionally allow unauthenticated requests to
# public allowlisted hosts WITHOUT server-side secrets. Server-side secrets
# (`authSecretRef`) remain strictly blocked without backend authentication.
FOLIO_PROXY_ALLOW_UNAUTHENTICATED_PUBLIC=false

# Server-side secrets referenced by Node Logic `authSecretRef` (e.g. API_TOKEN):
# Pattern: FOLIO_SECRET_<AUTH_SECRET_REF>
# Optional per-secret host restriction: FOLIO_SECRET_<AUTH_SECRET_REF>_HOSTS
FOLIO_SECRET_API_TOKEN=
FOLIO_SECRET_API_TOKEN_HOSTS=
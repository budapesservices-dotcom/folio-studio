# Cloudflare Pages cache-control rules for Folio Studio
# Always revalidate HTML entrypoints so deployments never serve stale builds.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Content-hashed Vite bundles are safe to cache immutably at the edge.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

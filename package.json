{
  "name": "folio-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "description": "Folio Studio — hybrid visual design, prototyping, animation and visual-to-code workspace.",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/lint-check.mjs",
    "test": "vitest run --exclude '**/*.perf.test.ts'",
    "test:unit": "vitest run --exclude '**/*.browser.test.mjs' --exclude '**/*.perf.test.ts'",
    "test:perf": "vitest run --fileParallelism=false .perf.test.ts",
    "test:browser": "vitest run --fileParallelism=false .browser.test.mjs",
    "benchmark": "node scripts/run-benchmark.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}